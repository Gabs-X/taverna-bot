# Copie este arquivo para .env e cole o token do bot (Developer Portal → Bot → Reset Token).
# Nunca suba o .env para o GitHub.
DISCORD_TOKEN=

# Opcional: bots ajudantes de música (cada um toca em mais uma call ao mesmo tempo).
# Crie outro aplicativo no Developer Portal, pegue o token e convide para o servidor (Connect, Speak, View Channels).
TOKEN_MUSICA_2=

# PC dos bardos: vigia o Taverneiro na nuvem e traz o backup diário (usuario@ip; chave em ~/.ssh/taverna_oracle ou NUVEM_CHAVE)
NUVEM_SSH=
# A mesma NUVEM_SSH liga a música ao mapa das campanhas (o mestre controla os bardos pelo mapa): túnel SSH local
# na porta 53136 até o mapa na nuvem. Opcional: PONTE_PORTA (porta local) e NUVEM_MAPA_PORTA (porta do mapa lá).
